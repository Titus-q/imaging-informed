.hero { margin: 20rpx 0 44rpx; }.title { display: block; font-size: 58rpx; line-height: 1.2; font-weight: 800; letter-spacing: -2rpx; }.subtitle { display: block; margin-top: 22rpx; color: #64766f; font-size: 30rpx; line-height: 1.65; }.upload-card { display: grid; grid-template-columns: 76rpx 1fr; column-gap: 18rpx; align-items: center; }.icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #fff0eb; color: #c85e4b; font-size: 40rpx; }.blue { background: #eaf5fa; color: #3980a8; }.card-title { display: block; font-size: 36rpx; font-weight: 700; }.select-button { grid-column: 1 / 3; margin-top: 28rpx; border: 1rpx solid #9bbdb0; border-radius: 14rpx; background: #f1f9f5; color: #156a5c; font-weight: 700; }.file-name { grid-column: 1 / 3; margin-top: 18rpx; color: #156a5c; font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.primary { margin-top: 28rpx; }.imaging-entry { display: flex; align-items: center; gap: 18rpx; }.imaging-entry > view:nth-child(2) { flex: 1; }.arrow { font-size: 52rpx; color: #749087; }.privacy-row { display: flex; align-items: center; margin: 30rpx 4rpx; color: #64766f; font-size: 24rpx; }
.privacy-row checkbox-group { flex-shrink: 0; margin-right: 8rpx; }.privacy-link { color: #156a5c; }
